
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Krishi Nexus | Loading</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
      background: linear-gradient(135deg, #f4fff2, #d9f5d1);
      color: #174d27;
    }

    .splash-screen {
      text-align: center;
      animation: fadeIn 1s ease-in-out;
      padding: 20px;
    }

    .logo-container {
      width: 150px;
      height: 150px;
      margin: 0 auto 25px;
      border: 4px solid rgba(46, 139, 63, 0.15);
      border-top: 4px solid #27823b;
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      animation: spin 1.5s linear infinite;
    }

    .logo {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      background: #ffffff;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      box-shadow: 0 8px 25px rgba(25, 90, 35, 0.12);
      animation: counterSpin 1.5s linear infinite;
    }

    .logo-icon {
      font-size: 44px;
      line-height: 1.2;
    }

    .logo-text {
      font-size: 12px;
      font-weight: bold;
      letter-spacing: 1px;
      color: #237638;
    }

    h1 {
      font-size: 34px;
      font-weight: 800;
      letter-spacing: 1px;
      margin-bottom: 10px;
    }

    h1 span {
      color: #78a92d;
    }

    .tagline {
      color: #53755a;
      font-size: 14px;
      margin-bottom: 30px;
      letter-spacing: 0.5px;
    }

    .loading-bar {
      width: 220px;
      height: 5px;
      background: #c8e8c1;
      border-radius: 10px;
      margin: 0 auto 14px;
      overflow: hidden;
    }

    .loading-progress {
      width: 0%;
      height: 100%;
      background: linear-gradient(90deg, #27823b, #a3ce46);
      border-radius: 10px;
      animation: load 3s linear forwards;
    }

    .loading-text {
      font-size: 12px;
      color: #53755a;
      letter-spacing: 2px;
      animation: pulse 1.2s infinite;
    }

    .footer {
      position: fixed;
      bottom: 25px;
      font-size: 11px;
      color: #709276;
      text-align: center;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    @keyframes counterSpin {
      to { transform: rotate(-360deg); }
    }

    @keyframes load {
      to { width: 100%; }
    }

    @keyframes pulse {
      50% { opacity: 0.45; }
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(15px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 480px) {
      h1 { font-size: 28px; }

      .logo-container {
        width: 130px;
        height: 130px;
      }

      .logo {
        width: 104px;
        height: 104px;
      }
    }
  </style>
</head>

<body>
  <main class="splash-screen">
    <div class="logo-container">
      <div class="logo">
        <div class="logo-icon">🌾</div>
        <div class="logo-text">KRISHI NEXUS</div>
      </div>
    </div>

    <h1>Krishi <span>Nexus</span></h1>

    <p class="tagline">
      Connecting Farmers. Growing Futures.
    </p>

    <div class="loading-bar">
      <div class="loading-progress"></div>
    </div>

    <p class="loading-text">LOADING YOUR EXPERIENCE...</p>
  </main>

  <div class="footer">
    Empowering Agriculture Through Technology
  </div>

  <script>
    setTimeout(() => {
      window.location.replace("/home");
    }, 3000);
  </script>
</body>
</html>
